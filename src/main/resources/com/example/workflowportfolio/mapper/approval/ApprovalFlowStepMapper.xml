<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.workflowportfolio.approval.mapper.ApprovalFlowStepMapper">

<select id="findByFlowId"
		resultType ="com.example.workflowportfolio.approval.entity.ApprovalFlowStep">

SELECT
	id,
	flow_id,
	step_no,
	approver_position_id
FROM
	approval_flow_steps
WHERE
	flow_id = #{flowId}
ORDER BY 
	step_no

</select>

</mapper>